#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1


# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed


ifeq ($(shell dpkg-vendor --derives-from Ubuntu && echo yes),yes)
	DISTBUILDDEPENDS = -Vdist:BuildDepends="libssl-dev"
else
	DISTBUILDDEPENDS = -Vdist:BuildDepends="libssl1.0-dev"
endif

clean:
	dh_testdir
	dh_auto_configure
	dh_auto_clean
	dh_clean

%:
	dh $@  --with autotools_dev

override_dh_autoreconf:
	./autogen.sh

# no package ships the static archives, and rudiments.spec configures the same
# way, so don't build them just to throw them away
override_dh_auto_configure:
	dh_auto_configure -- --disable-static

# librudiments-apache takes its ap_ and apr_ symbols from the httpd process it
# is loaded into, and links no apache library, so dpkg-shlibdeps can't resolve
# them and warns about every one.  librudiments is still scanned, and that is
# where the real dependencies come from.
override_dh_shlibdeps:
	dh_shlibdeps -Xlibrudiments-apache

override_dh_builddeb:
	dh_builddeb -- -Zgzip
