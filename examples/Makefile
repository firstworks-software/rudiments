.SUFFIXES: .lo .obj .cpp

.cpp.lo:
	$(LTCOMPILE) $(CXX) $(CXXFLAGS) $(CPPFLAGS) $(COMPILE) $< $(OUT)$@

.cpp.obj:
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $(COMPILE) $<

all: $(PROGS)

clean:
	$(RM) $(PROGS0)
	$(RM) $(PROGS1)
	$(RM) $(PROGS2)
	$(RM) *.lo *.o *.obj shm sem testfile testfile1 testfile2 *.ii
	$(RMTREE) .libs

