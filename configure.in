echo "******************************"


dnl Checks for prompt functions
echo
echo "***** Prompt Libraries *******"

if ( test "$INCLUDE_PROMPT" = "1" -a "$ENABLE_RUDIMENTS_LIBEDIT" = "yes" )
then

	if ( test -z "$LIBEDITLIBS" -a -z "$LIBEDITINCLUDES" )
	then

		AC_MSG_CHECKING(for termcap)
		FW_CHECK_HEADERS_AND_LIBS([/usr],[termcap],[termcap.h],[termcap],[""],[""],[TERMCAPINCLUDES],[TERMCAPLIBS],[TERMCAPLIBPATH],[TERMCAPSTATIC])
		if ( test -n "$TERMCAPLIBS" )
		then
			AC_MSG_RESULT(yes)
		else
			AC_MSG_RESULT(no)
		fi

		AC_MSG_CHECKING(for libedit)
		FW_CHECK_HEADERS_AND_LIBS([/usr],[editline],[editline/readline.h],[edit],[""],[""],[LIBEDITINCLUDES],[LIBEDITLIBS],[LIBEDITLIBPATH],[LIBEDITSTATIC])
		if ( test -n "$LIBEDITLIBS" )
		then
			LIBEDITLIBS="$LIBEDITLIBS"
			AC_MSG_RESULT(yes)
		else
			AC_MSG_RESULT(no)
		fi

		LIBEDITINCLUDES="$LIBEDITINCLUDES $TERMCAPINCLUDES"

		LIBEDITLIBS="$LIBEDITLIBS $TERMCAPLIBS"

		AC_MSG_CHECKING(whether libedit works)
		FW_TRY_LINK([#include <stdio.h>
#include <editline/readline.h>
],[add_history(NULL); read_history(NULL); write_history(NULL); readline(NULL);],[$LIBEDITINCLUDES],[$LIBEDITLIBS],[],[AC_MSG_RESULT(yes)],[AC_MSG_RESULT(no); LIBEDITLIBS=""])

		if ( test -n "$LIBEDITLIBS" )
		then
			AC_MSG_CHECKING(for history_truncate_file)
			FW_TRY_LINK([#include <stdio.h>
#include <editline/readline.h>
],[history_truncate_file(NULL,0);],[$LIBEDITINCLUDES],[$LIBEDITLIBS],[],[AC_MSG_RESULT(yes); AC_DEFINE_UNQUOTED(RUDIMENTS_LIBEDIT_HAS_HISTORY_TRUNCATE_FILE,1,Modern versions of libedit provide history_truncate_file)],[AC_MSG_RESULT(no)])
		fi
	fi

	AC_SUBST(LIBEDITINCLUDES)
	AC_SUBST(LIBEDITLIBS)
	
	if ( test -n "$LIBEDITLIBS" )
	then
		AC_DEFINE_UNQUOTED(RUDIMENTS_HAVE_LIBEDIT,1,Do we have libedit)
	fi

	case $host_os in
		*haiku* )
                	AC_DEFINE(ADD_NEWLINE_AFTER_READ_FROM_STDIN,1,On some platforms, you have to add a newline after reading from stdin)
			;;
		* )
			;;
	esac
fi

echo "******************************"


dnl Check for Apache module api
echo
echo "***** Apache *****************"
FW_CHECK_APACHE
if ( test "$INCLUDE_APACHE" = "1" )
then
	if ( test -n "$DARWIN" )
	then
		if ( test -n "$BUNDLE_LOADER" )
		then
			APACHELINKFLAGS="$APACHELINKFLAGS \$(MODLINKFLAGS)"
		else
			APACHELINKFLAGS="$APACHELINKFLAGS \$(LINKFLAGS)"
		fi
	else
		APACHELINKFLAGS="\$(LINKFLAGS)"
	fi
fi
AC_SUBST(APACHELINKFLAGS)
