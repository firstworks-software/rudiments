	#include <windows.h>
#endif],
LoadLibraryEx("",NULL,0);,AC_DEFINE(RUDIMENTS_HAVE_LOADLIBRARYEX,1,Some systems have LoadLibraryEx) AC_MSG_RESULT(yes), AC_MSG_RESULT(no))

AC_MSG_CHECKING(for NSLinkModule)
AC_TRY_COMPILE([#ifdef RUDIMENTS_HAVE_MACH_O_DYLD_H
	#include <mach-o/dyld.h>
#endif],
NSLinkModule(0,0,0);,AC_DEFINE(RUDIMENTS_HAVE_NSLINKMODULE,1,Some systems have NSLinkModule) AC_MSG_RESULT(yes), AC_MSG_RESULT(no))

