dnl Process this file with autoconf to produce a configure script.
AC_INIT(src/process.cpp)


AC_ARG_ENABLE(small-code,
	[  --enable-small-code     optimize for small code size],
	SMALLCODE="-O -Os -fno-exceptions",
	SMALLCODE="")
AC_ARG_ENABLE(debug,
	[  --enable-debug          compile with -g option],
	DEBUG="yes",
	DEBUG="")
AC_ARG_ENABLE(profiling,
	[  --enable-profiling      compile with -pg option],
	CXXFLAGS="$CXXFLAGS -pg",
	CXXFLAGS="$CXXFLAGS")
AC_ARG_ENABLE(fortify,
	[  --enable-fortify        compile with various gcc fortification options],
	CXXFLAGS="$CXXFLAGS -O -D_FORTIFY_SOURCE=2 -fstack-protector-strong",
	CXXFLAGS="$CXXFLAGS")
AC_ARG_ENABLE(wall,
	[  --disable-wall          compile without -Wall, even if supported],
	ENABLE_WALL="",
	ENABLE_WALL="yes")
AC_ARG_ENABLE(werror,
	[  --disable-werror        compile without -Werror, even if supported],
	ENABLE_WERROR="",
	ENABLE_WERROR="yes")
AC_ARG_ENABLE(enosys-notify,
	[  --enable-enosys-notify  enable runtime notification of methods that set ENOSYS],
	RUDIMENTS_ENOSYS_NOTIFY="yes",
	RUDIMENTS_ENOSYS_NOTIFY="")
AC_ARG_WITH(system-libtool,
	[  --with-system-libtool   use system libtool instead of ./libtool],
	USE_SYSTEM_LIBTOOL=$withval,
	USE_SYSTEM_LIBTOOL="no")
AC_ARG_WITH(pthread-prefix,
	[  --with-pthread-prefix   Location of pthread library],
	PTHREADPATH="$withval",
	PTHREADPATH="")
AC_ARG_ENABLE(libedit,
	[  --disable-libedit       Disable libedit support],
	ENABLE_RUDIMENTS_LIBEDIT="no",
	ENABLE_RUDIMENTS_LIBEDIT="yes")
AC_ARG_WITH(libedit-includes,
	[  --with-libedit-includes libedit includes],
	LIBEDITINCLUDES="$withval",
	LIBEDITINCLUDES="")
AC_ARG_WITH(libedit-libs,
	[  --with-libedit-libs     libedit libraries],
	LIBEDITLIBS="$withval",
	LIBEDITLIBS="")
AC_ARG_ENABLE(ssl,
	[  --disable-ssl           Disable TLS/SSL support],
	ENABLE_RUDIMENTS_SSL="no",
	ENABLE_RUDIMENTS_SSL="yes")
AC_ARG_WITH(ssl-includes,
	[  --with-ssl-includes     TLS/SSL includes],
	SSLINCLUDES="$withval",
	SSLINCLUDES="")
AC_ARG_WITH(ssl-libs,
	[  --with-ssl-libs         TLS/SSL libraries],
	SSLLIBS="$withval",
	SSLLIBS="")
AC_ARG_ENABLE(gss,
	[  --disable-gss           Disable GSS support],
	ENABLE_RUDIMENTS_GSS="no",
	ENABLE_RUDIMENTS_GSS="yes")
AC_ARG_WITH(gss-includes,
	[  --with-gss-includes     GSS includes],
	GSSINCLUDES="$withval",
	GSSINCLUDES="")
AC_ARG_WITH(gss-libs,
	[  --with-gss-libs         GSS libraries],
	GSSLIBS="$withval",
	GSSLIBS="")
AC_ARG_ENABLE(pcre,
	[  --disable-pcre          Don't use PCRE for regular expressions],
	ENABLE_RUDIMENTS_PCRE="no",
	ENABLE_RUDIMENTS_PCRE="yes")
AC_ARG_WITH(pcre-includes,
	[  --with-pcre-includes    PCRE includes],
	PCREINCLUDES="$withval",
	PCREINCLUDES="")
AC_ARG_WITH(pcre-libs,
	[  --with-pcre-libs        PCRE libraries],
	PCRELIBS="$withval",
	PCRELIBS="")
AC_ARG_ENABLE(libcurl,
	[  --disable-libcurl       Disable libcurl support],
	ENABLE_RUDIMENTS_LIBCURL="no",
	ENABLE_RUDIMENTS_LIBCURL="yes")
AC_ARG_WITH(libcurl-includes,
	[  --with-libcurl-includes libcurl includes],
	LIBCURLINCLUDES="$withval",
	LIBCURLINCLUDES="")
AC_ARG_WITH(libcurl-libs,
	[  --with-libcurl-libs     libcurl libraries],
	LIBCURLLIBS="$withval",
	LIBCURLLIBS="")
AC_ARG_ENABLE(built-in-regex,
	[  --enable-built-in-regex Use the built-in regex],
	USE_BUILT_IN_REGULAREXPRESSION="1",
	USE_BUILT_IN_REGULAREXPRESSION="0")
AC_ARG_ENABLE(threads,
	[  --disable-threads       Disable thread support],
	ENABLE_RUDIMENTS_THREADS="no"; INCLUDE_THREAD="0",
	ENABLE_RUDIMENTS_THREADS="yes")

