AC_TRY_COMPILE([
#if defined(RUDIMENTS_HAVE_SYS_TYPES_H)
	#include <sys/types.h>
#endif
#include <dirent.h>],
[],AC_DEFINE(RUDIMENTS_HAVE_DIRENT_H, 1, Some systems have dirent.h) AC_MSG_RESULT(yes),AC_MSG_RESULT(no))

