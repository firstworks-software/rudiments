	<b><font color="#000000">ucs2literal</font></b><font color="#990000">(</font>uGOODBYE<font color="#990000">,</font><font color="#FF0000">"GOODBYE"</font><font color="#990000">);</font>
	<b><font color="#000000">ucs2literal</font></b><font color="#990000">(</font>uHI<font color="#990000">,</font><font color="#FF0000">"HI"</font><font color="#990000">);</font>

