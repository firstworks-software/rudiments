	<font color="#FF0000">}</font><font color="#990000">;</font>
	<b><font color="#0000FF">const</font></b> ucs2_t <font color="#990000">*</font> <b><font color="#0000FF">const</font></b> uppercaseexpressions<font color="#990000">[]=</font><font color="#FF0000">{</font>
		uHELLO<font color="#990000">,</font>uHI<font color="#990000">,</font>uBYE<font color="#990000">,</font>uGOODBYE<font color="#990000">,</font>NULL
	<font color="#FF0000">}</font><font color="#990000">;</font>

