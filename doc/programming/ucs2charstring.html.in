	<b><font color="#0000FF">for</font></b> <font color="#990000">(</font><b><font color="#0000FF">const</font></b> ucs2_t <font color="#990000">*</font> <b><font color="#0000FF">const</font></b> <font color="#990000">*</font>le<font color="#990000">=</font>lowercaseexpressions<font color="#990000">;</font> <font color="#990000">*</font>le<font color="#990000">;</font> le<font color="#990000">++)</font> <font color="#FF0000">{</font>
		<font color="#009900">char</font>	<font color="#990000">*</font>lestr<font color="#990000">=</font>charstring<font color="#990000">::</font><b><font color="#000000">duplicateUcs2</font></b><font color="#990000">(*</font>le<font color="#990000">);</font>
		stdoutput<font color="#990000">.</font><b><font color="#000000">printf</font></b><font color="#990000">(</font><font color="#FF0000">"  is </font><font color="#CC33CC">\"</font><font color="#FF0000">%s</font><font color="#CC33CC">\"</font><font color="#FF0000"> a greeting?  %s</font><font color="#CC33CC">\n</font><font color="#FF0000">"</font><font color="#990000">,</font>lestr<font color="#990000">,</font>
