	<b><font color="#0000FF">for</font></b> <font color="#990000">(</font><b><font color="#0000FF">const</font></b> ucs2_t <font color="#990000">*</font> <b><font color="#0000FF">const</font></b> <font color="#990000">*</font>ue<font color="#990000">=</font>uppercaseexpressions<font color="#990000">;</font> <font color="#990000">*</font>ue<font color="#990000">;</font> ue<font color="#990000">++)</font> <font color="#FF0000">{</font>
