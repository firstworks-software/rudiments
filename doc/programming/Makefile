# fragments the pages here include; editing one rebuilds all of them
FRAGMENTS = contentend.html \
	contentstart.html \
	footer.html \
	header.html.in \
	projectheader.html \
	title.html \
	tracker.html

.PRECIOUS: $(INS)

.wt.html.in:
	wt -i $< -o $@

.html.in.html:
	$(SSI) $<

all: $(OBJS)
	$(CHMOD) 644 $(OBJS)

$(OBJS): $(FRAGMENTS)

clean:
	$(RM) $(OBJS) $(WTOBJS)
